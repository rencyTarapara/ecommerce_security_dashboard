# Copy this file to .streamlit/secrets.toml and fill in your values.
# NEVER commit the actual secrets.toml to Git.
#
# Key structure that the application expects:
#   st.secrets["EMAIL"]["sender"]       → email address used to send notifications
#   st.secrets["EMAIL"]["app_password"] → Gmail App Password (not your account password)
#
# To generate a Gmail App Password:
#   1. Enable 2-Factor Authentication on your Gmail account.
#   2. Go to Google Account → Security → App Passwords.
#   3. Generate a password for "Mail" / "Other".
#   4. Paste it here.

[EMAIL]
sender = "your-email@gmail.com"
app_password = "your-gmail-app-password"
